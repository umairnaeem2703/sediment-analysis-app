{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/ruff_format.py"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/layer_check.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/context_check.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/context_check.py"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/pause.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(.venv/Scripts/python -m pytest:*)",
      "Bash(python -m ruff check:*)",
      "Bash(python -m ruff format:*)",
      "Bash(.venv/Scripts/python -m ruff check:*)",
      "Bash(.venv/Scripts/python -m ruff format:*)",
      "Bash(python app.py)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
